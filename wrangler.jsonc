{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fizix",
  "compatibility_date": "2026-08-30",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
