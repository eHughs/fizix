{
  "name": "trader-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cloudflare:build": "node scripts/prepare-cloudflare-deploy.mjs",
    "start": "npm run cloudflare:build && npx wrangler dev",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run cloudflare:build && npx wrangler deploy --dry-run",
    "deploy": "npm run cloudflare:build && npx wrangler deploy",
    "email:apply": "node scripts/apply-supabase-email-templates.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
