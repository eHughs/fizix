{
  "name": "trader-analytics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:vinext": "vinext dev --port 3001",
    "build": "vinext build",
    "build:next": "next build",
    "build:vinext": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:next": "next start",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build:next && npm run build",
    "deploy": "wrangler deploy --config dist/server/wrangler.json",
    "deploy:vinext": "wrangler deploy --config dist/server/wrangler.json"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "^3.10.1",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
